# Copy this to .env and fill in real values — never commit .env
# Run: cp .env.example .env

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inzozi_motors
DB_USER=inzozi
DB_PASSWORD=CHANGE_ME

# JWT
JWT_SECRET=CHANGE_ME_USE_LONG_RANDOM_STRING
JWT_EXPIRES_IN=30d

# Server
PORT=3000
NODE_ENV=production

# CORS — comma-separated list of allowed origins
# During dev: http://localhost:8081
# In production: your Expo app's bundle ID won't send an Origin header,
# so set CORS_ORIGINS=* or to your web preview URL
CORS_ORIGINS=*

# File uploads — local disk path for inspection photos
UPLOAD_DIR=/var/www/inzozi-uploads

# (Future) Cloudinary — for optimised photo delivery
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# (Future) Africa's Talking — SMS/WhatsApp notifications
# AT_API_KEY=CHANGE_ME
# AT_USERNAME=CHANGE_ME
