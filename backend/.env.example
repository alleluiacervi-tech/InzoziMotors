# Sawa — Backend Environment Variables
# For local dev (non-Docker): cp .env.example .env
# For Docker: values are injected by docker-compose.yml automatically.

# PostgreSQL (matches Docker Compose defaults)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sawa
DB_USER=sawa
DB_PASSWORD=sawa_dev

# TLS to the database. Leave unset when Postgres is on the same host as the API
# (the documented VPS layout) — it does not speak TLS there, and demanding it
# means nothing connects.
#   require  encrypt, do NOT verify the certificate
#   verify   encrypt AND verify — use this for any managed/remote database,
#            with DB_SSL_CA when the cert is not signed by a public root
# DB_SSL=verify
# DB_SSL_CA=/etc/ssl/certs/db-ca.pem

# JWT
JWT_SECRET=dev_jwt_secret_change_in_production
JWT_EXPIRES_IN=30d

# Server
PORT=3000
NODE_ENV=development

# CORS — * allows any origin (fine for dev; restrict in production).
# Three first-party clients share this API:
#   the Expo app (native, no Origin header — CORS does not apply to it),
#   the admin dashboard (Next.js, :3001),
#   the public website (Next.js, :3002 — server-rendered pages call the API
#   from the Next server, but client-side actions come from the browser).
CORS_ORIGINS=*

# Password reset — until Phase 8 wires email/SMS, the 6-digit code is always
# written to the server log. Uncomment ONLY on a local machine to also return it
# in the API response; on any reachable host that gives every account away to an
# unauthenticated caller. Must stay unset in production.
# RESET_CODE_ECHO=true

# File uploads — local path for inspection photos
UPLOAD_DIR=./uploads

# Admin seed account (used by src/seed-admin.js on first start).
# The seed CREATES only — it never overwrites an existing admin's password —
# and refuses to run in production without SEED_ADMIN_PASSWORD set.
SEED_ADMIN_EMAIL=admin@sawacars.com
SEED_ADMIN_PASSWORD=admin1234

# ── Revenue (USD integers) ───────────────────────────────────────────────────
# Recorded in platform_fees at the business event; collection is offline, at
# the center. Each defaults to "not charged" so nothing is invoiced until the
# real number is set here.
#   CERTIFICATION_FEE — charged once per car when its 150-point inspection
#                       completes (covers inspection, photography, listing).
#   COMMISSION_RATE   — fraction of the agreed price when a handover completes.
#   REFERRAL_DISCOUNT — fraction off the next commission for a redeemed code.
CERTIFICATION_FEE=0
COMMISSION_RATE=0.05
REFERRAL_DISCOUNT=0.2

# ── Production-only (fill in when deploying to VPS) ─────────────────────────
# NODE_ENV=production   ← replace the development value above; enables DB SSL
# DB_PASSWORD=CHANGE_TO_STRONG_PASSWORD
# JWT_SECRET=CHANGE_TO_LONG_RANDOM_STRING
# CORS_ORIGINS=https://sawacars.com,https://www.sawacars.com,https://admin.sawacars.com
# UPLOAD_DIR=/var/www/sawa-uploads

# ── Future integrations ──────────────────────────────────────────────────────
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# AT_API_KEY=your_africas_talking_key
# AT_USERNAME=your_at_username
# ── Email delivery (Phase 8) — set these to make password reset emails real ──
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=Sawa <no-reply@sawacars.com>
