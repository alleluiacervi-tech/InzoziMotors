# Sawa — Backend Environment Variables
# For local dev (non-Docker): cp .env.example .env
# For Docker: values are injected by docker-compose.yml automatically.

# PostgreSQL (matches Docker Compose defaults)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sawa
DB_USER=sawa
DB_PASSWORD=sawa_dev

# TLS to the database. Leave unset when Postgres is on the same host as the API
# (the documented VPS layout) — it does not speak TLS there, and demanding it
# means nothing connects.
#   require  encrypt, do NOT verify the certificate
#   verify   encrypt AND verify — use this for any managed/remote database,
#            with DB_SSL_CA when the cert is not signed by a public root
# DB_SSL=verify
# DB_SSL_CA=/etc/ssl/certs/db-ca.pem

# JWT
JWT_SECRET=dev_jwt_secret_change_in_production
JWT_EXPIRES_IN=30d

# Server
PORT=3000
NODE_ENV=development

# CORS — * allows any origin (fine for dev; restrict in production).
# Three first-party clients share this API:
#   the Expo app (native, no Origin header — CORS does not apply to it),
#   the admin dashboard (Next.js, :3001),
#   the public website (Next.js, :3002 — server-rendered pages call the API
#   from the Next server, but client-side actions come from the browser).
CORS_ORIGINS=*

# Password reset — until Phase 8 wires email/SMS, the 6-digit code is always
# written to the server log. Uncomment ONLY on a local machine to also return it
# in the API response; on any reachable host that gives every account away to an
# unauthenticated caller. Must stay unset in production.
# RESET_CODE_ECHO=true

# File uploads — local path for inspection photos
UPLOAD_DIR=./uploads
# Where uploads live: 'local' (UPLOAD_DIR on disk, the default) is the only
# driver implemented today; the variable exists so Cloudinary/R2 can slot in
# without touching call sites (src/lib/storage.js).
# STORAGE_DRIVER=local

# ── Tuning knobs (sensible defaults, rarely changed) ─────────────────────────
# Max PostgreSQL connections held by this process (src/db.js; default 10).
# DB_POOL_MAX=10
# Log verbosity: error | warn | info | debug (src/lib/log.js; default info).
# LOG_LEVEL=info

# Admin seed account (used by src/seed-admin.js on first start).
# The seed CREATES only — it never overwrites an existing admin's password —
# and refuses to run in production without SEED_ADMIN_PASSWORD set.
SEED_ADMIN_EMAIL=admin@sawacars.com
SEED_ADMIN_PASSWORD=admin1234
# SEED_ADMIN_NAME=Sawa Admin

# Demo inventory (src/seed-cars.js, src/seed-rentals.js). Never seeds in
# production unless SEED_DEMO_DATA=true is set explicitly — and then the demo
# seller account below is created with these credentials, so set a real
# password before ever flipping it on a reachable host.
# SEED_DEMO_DATA=false
# SEED_SELLER_EMAIL=seller@sawacars.com
# SEED_SELLER_PASSWORD=
# SEED_SELLER_NAME=Demo Seller
# Base URL prefixed onto the bundled seed images (default http://localhost:3000).
# SEED_ASSET_BASE=

# ── Revenue (USD integers) ───────────────────────────────────────────────────
# Recorded in platform_fees at the business event; collection is offline, at
# the center. Each defaults to "not charged" so nothing is invoiced until the
# real number is set here.
#   CERTIFICATION_FEE — charged once per car when its 150-point inspection
#                       completes (covers inspection, photography, listing).
#   COMMISSION_RATE   — fraction of the agreed price when a handover completes.
#   REFERRAL_DISCOUNT — fraction off the next commission for a redeemed code.
CERTIFICATION_FEE=0
COMMISSION_RATE=0.05
REFERRAL_DISCOUNT=0.2

# ── Production-only (fill in when deploying to VPS) ─────────────────────────
# NODE_ENV=production   ← replace the development value above; enables DB SSL
# DB_PASSWORD=CHANGE_TO_STRONG_PASSWORD
# JWT_SECRET=CHANGE_TO_LONG_RANDOM_STRING
# CORS_ORIGINS=https://sawacars.com,https://www.sawacars.com,https://admin.sawacars.com
# UPLOAD_DIR=/var/www/sawa-uploads

# CLOUDINARY_URL=cloudinary://659495682444636:gcjC7snKcCaElVSIBUB6wrDcez4@xdhtdfxm
# CLOUDINARY_CLOUD_NAME=xdhtdfxm
# CLOUDINARY_API_KEY=659495682444636
# CLOUDINARY_API_SECRET=gcjC7snKcCaElVSIBUB6wrDcez4
# AT_API_KEY=your_africas_talking_key
# AT_USERNAME=your_at_username
# ── Email delivery (Phase 8) — set these to make password reset emails real ──
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=Sawa Cars <no-reply@sawacars.com>

# ─── Sale contracts (admin-only PDF generator) ────────────────────────────────
# The clauses in src/lib/contract/clauses.js have NOT been reviewed by a
# Rwandan advocate. While CONTRACT_DRAFT_MODE is anything other than the exact
# string "false", every generated page carries a "DRAFT — NOT FOR SIGNATURE"
# watermark. Flip it only once a lawyer has signed the wording off.
CONTRACT_DRAFT_MODE=true
#
# Printed on the contract letterhead. Legal name and TIN appear on the document
# itself, so they must match the company's registration exactly.
COMPANY_LEGAL_NAME=Sawa Cars Ltd
# COMPANY_TIN=
COMPANY_ADDRESS=Nyarutarama, Kigali, Rwanda
COMPANY_WEBSITE=sawacars.com
COMPANY_PHONE=+250 788 308 611
COMPANY_EMAIL=contact@sawacars.com

# Official vehicle-import invoice account. Never commit real credentials.
IMPORT_BANK_NAME=Bank of Kigali
IMPORT_BANK_ACCOUNT_NAME=
IMPORT_BANK_ACCOUNT_NUMBER=

# ── Pesapal — online payment for RENTALS only ────────────────────────────────
# Hosted checkout (cards + MTN MoMo + Airtel Money). Unset = the pay-online
# option simply doesn't exist: /payments answers 503 PAYMENTS_NOT_CONFIGURED
# and bookings fall back to pay-at-center. The deposit is NEVER charged online.
# Keys come from the Pesapal merchant portal; start with sandbox keys.
# PESAPAL_CONSUMER_KEY=
# PESAPAL_CONSUMER_SECRET=
# PESAPAL_ENV=sandbox
# PESAPAL_IPN_URL=https://api.sawacars.com/payments/ipn
# PESAPAL_CALLBACK_URL=https://sawacars.com/rentals/payment-return

# ── The contact@ mailbox (admin inbox) ───────────────────────────────────────
# Read over IMAP and answered over SMTP by the admin dashboard's Inbox page.
# A SEPARATE identity from the SMTP_* block above: contact@ is the address
# customers write to and every reply must come FROM it, while no-reply@ sends
# transactional mail nobody answers.
#
# Leave MAIL_USER/MAIL_PASS unset to disable the inbox — /mail then returns
# 503 MAIL_NOT_CONFIGURED and the page says the mailbox is not set up. It does
# not break anything else.
#
# MAIL_PASS is the mailbox password. Never commit it.
# MAIL_USER=contact@sawacars.com
# MAIL_PASS=
# MAIL_IMAP_HOST=imap.hostinger.com
# MAIL_IMAP_PORT=993
# MAIL_SMTP_HOST=smtp.hostinger.com
# MAIL_SMTP_PORT=465
