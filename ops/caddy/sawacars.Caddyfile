# Sawa — Caddy site blocks for the shared VPS (152.239.122.192).
#
# This host's Caddy also serves another project; its blocks live in the main
# /etc/caddy/Caddyfile and are NOT touched. Install this file as:
#
#     /etc/caddy/sites/sawacars.Caddyfile
#
# and add ONE line near the top of /etc/caddy/Caddyfile:
#
#     import sites/*
#
# Then, always in this order (a bad reload takes every site on the box down):
#     caddy validate --config /etc/caddy/Caddyfile
#     systemctl reload caddy
#
# TLS is automatic (ACME) — no certbot. Certificates are only issued once DNS
# for these names resolves to this server, so point the A records first; Caddy
# retries until issuance succeeds.
#
# Backends (host side — containers bind 127.0.0.1, ports 4000-4002 because the
# other project owns 3000):
#     api.sawacars.com    → 127.0.0.1:4000
#     admin.sawacars.com  → 127.0.0.1:4001
#     sawacars.com        → 127.0.0.1:4002

# ── The visitor's address, with or without Cloudflare in front ───────────────
# Behind Cloudflare every request arrives from a Cloudflare edge address, so
# keying rate limits on the connecting IP would put everyone using the same
# Cloudflare location (all of Kigali) in one bucket and lock them out together.
# Cloudflare sends the visitor's address in CF-Connecting-IP. It is believed
# ONLY when the connection really comes from Cloudflare's published ranges;
# a request sent straight to this server's IP cannot set it. Without
# Cloudflare nothing matches and the connecting address is used, as before.
#
# Ranges from https://www.cloudflare.com/ips (checked 14 Oct 2026). They change
# rarely; a stale list fails safe (that edge is treated as the visitor).
(sawa_client_ip) {
	vars client_ip {remote_host}
	@sawa_via_cloudflare {
		remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		header CF-Connecting-IP *
	}
	vars @sawa_via_cloudflare client_ip {http.request.header.CF-Connecting-IP}

	# Cloudflare's country estimate (CF-IPCountry) is recorded with each
	# account's addresses (backend/src/lib/client-ip.js). Only Cloudflare may
	# set it: from anywhere else it is removed, so it cannot be typed in by
	# calling this server directly. Same ranges as above.
	@sawa_not_cloudflare not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	request_header @sawa_not_cloudflare -CF-IPCountry
}

www.sawacars.com {
	# One canonical origin: metadataBase, the sitemap and every OG card are
	# built from https://sawacars.com — a second live hostname splits ranking.
	redir https://sawacars.com{uri} permanent
}

sawacars.com {
	encode zstd gzip

	# Only Caddy's forwarding headers may reach the app, never the client's.
	request_header -X-Forwarded-For
	request_header -X-Real-IP
	import sawa_client_ip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		-Server
	}

	reverse_proxy 127.0.0.1:4002 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-For {vars.client_ip}
	}
}

api.sawacars.com {
	encode zstd gzip

	# The API's express-rate-limit trusts exactly one proxy hop. The inbound
	# header is stripped and replaced with the one address sawa_client_ip
	# settled on, so a spoofed XFF can never become the address a rate-limit
	# bucket is keyed on.
	request_header -X-Forwarded-For
	request_header -X-Real-IP
	import sawa_client_ip

	# 36-angle photo batches; multer's own limits (10 MB/file × 40) are the
	# real ceiling — this just has to sit above them.
	request_body {
		max_size 100MB
	}

	# Websocket upgrade for Socket.io chat is automatic in reverse_proxy.
	reverse_proxy 127.0.0.1:4000 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-For {vars.client_ip}
	}
}

admin.sawacars.com {
	encode zstd gzip

	request_header -X-Forwarded-For
	request_header -X-Real-IP
	import sawa_client_ip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Operations tool — stays out of every index regardless of app config.
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	# KYC documents and photo uploads pass through the dashboard's own proxy.
	request_body {
		max_size 100MB
	}

	reverse_proxy 127.0.0.1:4001 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-For {vars.client_ip}
	}

	# Optional hardening once the team has fixed egress IPs:
	# @outside not remote_ip 203.0.113.7
	# respond @outside 403
}
