# Server-side only. The dashboard's browser code calls its own /api/backend
# proxy, which attaches the admin JWT from an httpOnly cookie and forwards the
# request — so this address is never exposed to a browser and may be private
# (a Docker service name, or 127.0.0.1 on the VPS).
#   Docker Compose : http://api:3000
#   Same VPS       : http://127.0.0.1:3000
#   Local dev      : http://localhost:3000
API_URL=http://localhost:3000

