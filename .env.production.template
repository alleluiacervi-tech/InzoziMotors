# ─── Sawa — production secrets ────────────────────────────────────────────────
# On the VPS:   cp .env.production.template .env   then fill EVERY value.
#
# This file is the template; the filled-in .env is gitignored and lives only on
# the server. Keep a copy of the filled values in your password manager — they
# are the keys to the business.
#
# The API refuses to boot in production if JWT_SECRET or DB_PASSWORD look like
# dev values, or if CORS_ORIGINS is missing/wildcard. A forgotten edit here
# fails loudly at start instead of quietly serving traffic.

# PostgreSQL — the container is created with this password on first start.
# Generate:  openssl rand -base64 24
DB_NAME=sawa
DB_USER=sawa
DB_PASSWORD=

# JWT signing secret. Every session on every surface depends on it; rotating it
# signs everyone out. Generate:  openssl rand -base64 48
JWT_SECRET=

# Browser origins allowed to call the API. The Expo app sends no Origin header,
# so it is unaffected by this list.
CORS_ORIGINS=https://sawacars.com,https://www.sawacars.com,https://admin.sawacars.com

# First admin account — created ONCE (insert-only; never overwrites). Sign in
# at https://admin.sawacars.com and change the password immediately, which
# also revokes any token minted with this value.
SEED_ADMIN_EMAIL=admin@sawacars.com
SEED_ADMIN_PASSWORD=

# ── Revenue (USD integers / fractions) ───────────────────────────────────────
# CERTIFICATION_FEE=0 means the fee is recorded for no one until the real
# price is decided — nothing is invoiced by accident.
CERTIFICATION_FEE=0
COMMISSION_RATE=0.05
REFERRAL_DISCOUNT=0.2

# ── Official company and import-invoice identity ─────────────────────────────
COMPANY_LEGAL_NAME=Sawa Cars Ltd
COMPANY_TIN=
COMPANY_ADDRESS=Nyarutarama, Kigali, Rwanda
COMPANY_WEBSITE=sawacars.com
COMPANY_PHONE=+250 788 308 611
COMPANY_EMAIL=contact@sawacars.com

# Fill these only in the VPS .env. They are printed on official deposit
# invoices; if either account field is blank the PDF safely tells the customer
# to confirm details instead of printing guessed banking credentials.
IMPORT_BANK_NAME=Bank of Kigali
IMPORT_BANK_ACCOUNT_NAME=
IMPORT_BANK_ACCOUNT_NUMBER=

# ── Transactional Email (Resend API) ─────────────────────────────────────────
# When RESEND_API_KEY is set, all verification and transactional emails send via Resend.
RESEND_API_KEY=
MAIL_FROM=Sawa Cars <no-reply@sawacars.com>

# ── Optional Fallback SMTP ──────────────────────────────────────────────────
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# ── Pesapal — online payment for RENTALS only (cards + MoMo) ─────────────────
# Sandbox first: PESAPAL_ENV=sandbox with sandbox keys, then flip to live.
# Unset = pay-online is simply unavailable; bookings fall back to pay-at-center.
# PESAPAL_CONSUMER_KEY=
# PESAPAL_CONSUMER_SECRET=
# PESAPAL_ENV=sandbox

# ── Cloudinary — CDN Media & Photo Storage ──────────────────────────────────
# Automatically uploads vehicle and inspection photos to Cloudinary CDN.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Backups (ops/backup.sh cron) ─────────────────────────────────────────────
# BACKUP_REMOTE=user@backup-host:/srv/sawa-backups   # off-site copy via rsync

